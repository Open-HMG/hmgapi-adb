{
  "id": "adb",
  "name": "ADB",
  "version": "1.0.1-rc.1",
  "hmgapi": ">=1.0.0",
  "authors": ["VysseCodes"],
  "license": "AGPL-3.0",
  "nemesis_conflicts": ["adb.tcp"],
  "description": "adb over USB and over the car's hotspot (port 5555), each on or off, applied right away. Replaces the Engineering Mode ADB TCP switch, which puts eth0 on the hotspot's subnet and breaks wireless CarPlay and Android Auto.",
  "system": { "platform": ["tcc803x"] },
  "parts": [
    { "id": "usb", "when": "settings.usb" },
    { "id": "no_usb", "when": "!settings.usb" },
    { "id": "tcp", "when": "settings.tcp" },
    { "id": "no_tcp", "when": "!settings.tcp" }
  ],
  "network": {
    "rules": [
      {
        "chain": "input",
        "in": "hotspot",
        "proto": "tcp",
        "ports": [5555],
        "action": "accept",
        "when": "settings.tcp"
      }
    ]
  }
}
